<h1>Liste des voitures</h1>
<table border="1">
    <tr>
        <td>Série</td>
        <td>Date Mise en Marche</td>
        <td>Modèle</td>
    </tr>

    {% for v in listVoitures %}
    <tr>
        <td>{{ v.serie }}</td>
        <td>{{ v.dateMiseEnMarche | date }}</td>
        <td>{{ v.modele.libelle ?? '' }}</td>
        <td><a href="{{ path("voitureDelete", { 'id':v.id } )}}">Supprimer </a></td>
        <td><a href="{{ path("voitureUpdate", { 'id':v.id } )}}">Update </a></td>
    </tr>
    {% endfor %}
</table>
